# Line endings are pinned to LF in the working tree, not only in the
# repository. gofmt reports a CRLF file as unformatted, so on a Windows
# checkout with core.autocrlf=true the check that has to print nothing printed
# every file. Normalising the working tree makes the standard checks mean the
# same thing everywhere.
* text=auto eol=lf

*.png binary
